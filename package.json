{
  "name": "ondes",
  "private": true,
  "version": "1.0.0",
  "description": "Ondes : vos radios en direct, sans coupure publicitaire ajoutée. Application web installable pour iPhone.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "art": "tsx scripts/generate-art.ts",
    "check:streams": "tsx scripts/check-streams.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/doto": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "hls.js": "^1.7.3",
    "preact": "^10.29.8",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
